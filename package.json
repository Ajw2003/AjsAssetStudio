{
  "name": "ajs-asset-studio",
  "version": "1.0.0",
  "description": "Sketch to game-asset concept art, with local AI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "e2e": "node test/e2e.js",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "license": "ISC",
  "dependencies": {
    "perfect-freehand": "^1.2.3"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright": "^1.56.1"
  },
  "build": {
    "appId": "com.ajw2003.assetstudio",
    "productName": "Ajs Asset Studio",
    "files": [
      "*.js",
      "index.html",
      "style.css",
      "!test/**",
      "!docs/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true
    }
  }
}
